<Project Sdk="Microsoft.NET.Sdk">
  <!-- M031 source-only C# compilation gate.
       No LEAN engine, brokerage, historical simulation or order execution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicit version: never restore an unpinned 'latest' LEAN API. -->
    <PackageReference Include="QuantConnect.Algorithm" Version="2.5.18248" />
    <Compile Include="M031FrozenData.cs" />
    <Compile Include="M031FrozenBaselineAlgorithm.cs" />
  </ItemGroup>
</Project>
